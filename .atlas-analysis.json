  "keyFeatures": [
    "Movie and TV series discovery powered by TMDB",
    "User authentication with email/password, Google OAuth, and anonymous accounts",
    "Personal watchlists and watch history synced across sessions",
    "Multi-source streaming player with provider health checks",
    "Real-time community live chat via Socket.IO and Supabase",
    "Advanced search with fuzzy matching, filters, and suggestions",
    "Plans and subscription management with per-user feature gates",
    "Admin dashboard for user management, chat moderation, and app settings",
    "Progressive Web App (PWA) support with offline caching",
    "Rate limiting, XSS protection, and CORS security middleware"
  ],
